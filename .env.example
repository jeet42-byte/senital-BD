# SQLite for local development; a PostgreSQL URL in production, e.g.
# postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./sentinel.db

# Free key from https://auth.abuse.ch - sent to URLhaus, ThreatFox and
# Feodo Tracker. Some abuse.ch endpoints refuse requests without one.
ABUSECH_AUTH_KEY=

# File of Bangladeshi IPv4 ranges, built by: python -m sentinel.bd update
BD_RANGES_PATH=data/bd_ipv4.txt
